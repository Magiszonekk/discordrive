{
  "name": "@ddv4/metadata-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "discordrive-next stage 2: metadata-only client (upload/download straight to the user's webhooks, index via @ddv4/sync-core). Node + browser.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "bin": {
    "ddn": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "DDN_LIVE=1 vitest run test/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/node/server-main.ts"
  },
  "dependencies": {
    "@ddv4/processing": "*",
    "@ddv4/sync-core": "*"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
