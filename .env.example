# === Database ===
# NOTE: port in DATABASE_URL must match POSTGRES_PORT below
DATABASE_URL=postgresql://ddv4:ddv4@localhost:5432/ddv4

# === Ports ===
API_PORT=3000
FRONTEND_PORT=5173

# === Storage providers ===
# Which provider(s) receive new uploads. Comma-separated list stripes chunks
# across them (aggregate throughput); a single value is single-provider.
# If unset, falls back to BLOB_STORAGE_KIND below.
#   STORAGE_PRIMARY_PROVIDERS=DISCORD
#   STORAGE_PRIMARY_PROVIDERS=DISCORD,TELEGRAM
STORAGE_PRIMARY_PROVIDERS=DISCORD
# Single-provider fallback (LOCAL | DISCORD | TELEGRAM). Used only when
# STORAGE_PRIMARY_PROVIDERS is unset. Default: LOCAL.
BLOB_STORAGE_KIND=DISCORD

# Providers to asynchronously replicate every blob onto, for durability against
# losing a provider account. Uses the REPLICA_* sender pools below. Empty/unset
# = replication disabled.
#   STORAGE_REPLICA_PROVIDERS=DISCORD
STORAGE_REPLICA_PROVIDERS=
# Parallelism of the in-process replication worker (default 2).
REPLICATION_CONCURRENCY=2

# === PRIMARY Discord senders ===
# Webhooks (WEBHOOK_1..50). Each MUST be on a separate Discord channel for
# rate-limit isolation.
WEBHOOK_1=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
WEBHOOK_2=
WEBHOOK_3=
# Optional bot senders (BOT_n token + BOT_n_CHANNEL id). Bots need
# READ_MESSAGE_HISTORY in their channel to serve downloads; enable with:
# BOT_UPLOADS_ENABLED=1
# BOT_1=
# BOT_1_CHANNEL=

# === PRIMARY Telegram senders (only if using TELEGRAM) ===
# One bot = one private channel/group. The bot must be an admin of the chat so
# it can delete its own messages on purge. chat id looks like -1001234567890.
# TG_BOT_1=123456:ABC-your-bot-token
# TG_BOT_1_CHAT=-1001234567890

# === REPLICA sender pools (only if STORAGE_REPLICA_PROVIDERS is set) ===
# PHYSICALLY SEPARATE senders — a different Discord server/account or Telegram
# bot than the primary pools — so replica copies survive loss of the primary
# account and never share rate-limit budgets with primary traffic.
# REPLICA_WEBHOOK_1=https://discord.com/api/webhooks/REPLICA_ID/REPLICA_TOKEN
# REPLICA_BOT_1=
# REPLICA_BOT_1_CHANNEL=
# REPLICA_TG_BOT_1=
# REPLICA_TG_BOT_1_CHAT=

# === Auth ===
JWT_SECRET=change-me-to-random-string
JWT_EXPIRES_IN=7d

# === Mode ===
# "full" — full app with users, auth, frontend, folders
# "backend-only" — API-only, no users, auth via API_KEY, no folders
APP_MODE=full
API_KEY=

# === Docker (infra/docker-compose.yml) ===
POSTGRES_PORT=5432
POSTGRES_USER=ddv4
POSTGRES_PASSWORD=ddv4
POSTGRES_DB=ddv4
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ddv4.local
PGADMIN_PASSWORD=admin
REDIS_PORT=6379

# === Video streaming (optional tuning) ===
VITE_STREAM_CHUNKS_AHEAD=3
VITE_STREAM_CHUNKS_BEHIND=2
