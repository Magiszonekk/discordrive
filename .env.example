# === Database ===
# NOTE: port in DATABASE_URL must match POSTGRES_PORT below
DATABASE_URL=postgresql://ddv4:ddv4@localhost:5432/ddv4

# === Ports ===
API_PORT=3000
FRONTEND_PORT=5173

# === Discord Webhooks (WEBHOOK_1, WEBHOOK_2, ...) ===
# Each webhook MUST be on a separate Discord channel for rate limit isolation.
WEBHOOK_1=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
WEBHOOK_2=
WEBHOOK_3=

# === Auth ===
JWT_SECRET=change-me-to-random-string
JWT_EXPIRES_IN=7d

# === Mode ===
# "full" — full app with users, auth, frontend, folders
# "backend-only" — API-only, no users, auth via API_KEY, no folders
APP_MODE=full
API_KEY=

# === Docker (infra/docker-compose.yml) ===
POSTGRES_PORT=5432
POSTGRES_USER=ddv4
POSTGRES_PASSWORD=ddv4
POSTGRES_DB=ddv4
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ddv4.local
PGADMIN_PASSWORD=admin
REDIS_PORT=6379

# === Video streaming (optional tuning) ===
VITE_STREAM_CHUNKS_AHEAD=3
VITE_STREAM_CHUNKS_BEHIND=2
