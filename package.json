{
  "name": "discordrive",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @discordrive/api dev",
    "dev:frontend": "pnpm --filter @discordrive/frontend dev",
    "db:generate": "pnpm --filter @discordrive/database generate",
    "db:push": "pnpm --filter @discordrive/database db:push",
    "typecheck": "tsc --build",
    "build": "pnpm --recursive run build --if-present",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:e2e": "tsx scripts/benchmark-e2e.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "galery": "file:../galery-plugin"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  }
}
