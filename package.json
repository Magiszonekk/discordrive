{
  "name": "ddv4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "npm run dev --workspace=@ddv4/api",
    "dev:frontend": "npm run dev --workspace=@ddv4/frontend",
    "start": "concurrently --kill-others-on-fail \"npm run start:api\" \"npm run start:frontend\"",
    "start:api": "npm run start --workspace=@ddv4/api",
    "start:frontend": "npm run preview --workspace=@ddv4/frontend",
    "db:generate": "npm run generate --workspace=@ddv4/database",
    "db:push": "npm run db:push --workspace=@ddv4/database",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@ddv4/api && npm run test --workspace=@ddv4/processing && npm run test --workspace=@ddv4/telegram-client",
    "test:integration": "npm run test:integration --workspace=@ddv4/api",
    "test:e2e:download": "tsx scripts/e2e-download-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:e2e": "tsx scripts/benchmark-e2e.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "playwright": "^1.59.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
