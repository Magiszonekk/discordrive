{
  "name": "discordrive",
  "private": true,
  "scripts": {
    "dev:api": "npm run dev --workspace=@discordrive/api",
    "dev:frontend": "npm run dev --workspace=@discordrive/frontend",
    "db:generate": "npm run generate --workspace=@discordrive/database",
    "db:push": "npm run db:push --workspace=@discordrive/database",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:e2e": "tsx scripts/benchmark-e2e.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "galery": "file:../galery-plugin"
  }
}
