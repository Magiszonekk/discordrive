<?xml version="1.0" encoding="utf-8"?>
<!-- Check boxes in lists (Trash): the accent when checked, rule-2 frame otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/cobalt_rule_2" android:state_enabled="false" />
    <item android:color="?attr/colorPrimary" android:state_checked="true" />
    <item android:color="@color/cobalt_muted" />
</selector>
