<?xml version="1.0" encoding="utf-8"?>
<!-- The Gallery's legend card: filled a step off the page (on the dark Cobalt a hairline frame alone disappears),
     a hairline rule, the card radius; no accent edge (it explains, it does not warn). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cobalt_card"/>
    <stroke android:width="1dp" android:color="@color/cobalt_rule"/>
    <corners android:radius="10dp"/>
</shape>
