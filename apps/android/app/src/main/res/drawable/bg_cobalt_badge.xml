<?xml version="1.0" encoding="utf-8"?>
<!-- The copy state's badge on a Gallery tile. It sits on the photo, not on the page, so it is the same in both
     modes: the scrim's blue-black (as under the viewer's bars) carries it over light photos, the light rim over
     dark ones. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#B8080B10"/>
    <stroke android:width="1dp" android:color="#80FFFFFF"/>
</shape>
