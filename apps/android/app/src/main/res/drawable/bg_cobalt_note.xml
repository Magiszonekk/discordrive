<?xml version="1.0" encoding="utf-8"?>
<!-- .note: hairline box with a 2dp accent edge on the left -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cobalt_paper" />
            <stroke android:width="1dp" android:color="@color/cobalt_rule" />
            <corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp" android:topRightRadius="10dp" android:bottomRightRadius="10dp" />
        </shape>
    </item>
</layer-list>
