<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt for Android: the look of discordrive web (apps/web-mo/cobalt) as a Material3 DayNight theme.
     Light / dark follow the system, like the web's "system" colour mode; colours in colors_cobalt.xml
     (+ values-night). Radii as on the web: 6dp buttons and inputs, 10dp cards and the QR field, 4dp chips.
     Type: Space Grotesk 600 for headings, Inter for text, JetBrains Mono for codes and numbers.
     Used by the join screen first; the other screens keep Theme.Gallery until their own pass. -->
<resources>
    <style name="Theme.Ddn.Cobalt" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cobalt_accent</item>
        <item name="colorOnPrimary">@color/cobalt_accent_ink</item>
        <item name="colorPrimaryContainer">@color/cobalt_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/cobalt_ink</item>
        <item name="colorSecondary">@color/cobalt_accent</item>
        <item name="colorOnSecondary">@color/cobalt_accent_ink</item>
        <item name="colorSecondaryContainer">@color/cobalt_paper_2</item>
        <item name="colorOnSecondaryContainer">@color/cobalt_ink</item>
        <item name="android:colorBackground">@color/cobalt_paper</item>
        <item name="colorOnBackground">@color/cobalt_ink</item>
        <item name="colorSurface">@color/cobalt_paper</item>
        <item name="colorOnSurface">@color/cobalt_ink</item>
        <item name="colorSurfaceVariant">@color/cobalt_paper_2</item>
        <item name="colorOnSurfaceVariant">@color/cobalt_muted</item>
        <item name="colorSurfaceContainerLowest">@color/cobalt_paper</item>
        <item name="colorSurfaceContainerLow">@color/cobalt_paper</item>
        <item name="colorSurfaceContainer">@color/cobalt_paper_2</item>
        <item name="colorSurfaceContainerHigh">@color/cobalt_paper_2</item>
        <item name="colorSurfaceContainerHighest">@color/cobalt_paper_3</item>
        <item name="colorOutline">@color/cobalt_rule_2</item>
        <item name="colorOutlineVariant">@color/cobalt_rule</item>
        <item name="colorError">@color/cobalt_error</item>
        <item name="colorOnError">@color/cobalt_accent_ink</item>
        <item name="colorControlNormal">@color/cobalt_muted</item>
        <item name="colorControlActivated">@color/cobalt_accent</item>
        <item name="colorControlHighlight">#1A7A8189</item>
        <item name="android:textColorPrimary">@color/cobalt_ink</item>
        <item name="android:textColorSecondary">@color/cobalt_muted</item>
        <item name="android:textColorHint">@color/cobalt_muted</item>
        <item name="android:textColorHighlight">#4D0076ED</item>
        <item name="android:windowBackground">@color/cobalt_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/cobalt_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/cobalt_light_bars</item>
        <item name="materialButtonStyle">@style/Widget.Cobalt.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Cobalt.Button.Secondary</item>
        <item name="textInputStyle">@style/Widget.Cobalt.TextInput</item>
        <!-- Section cards of the screens made in code: filled a step lighter than the page, no frame (the join
             screen sets Widget.Cobalt.Card itself and keeps its hairline). -->
        <item name="materialCardViewStyle">@style/Widget.Cobalt.Card.Section</item>
        <item name="checkboxStyle">@style/Widget.Cobalt.CheckBox</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Cobalt.Progress</item>
    </style>

    <!-- Type (web: h1 600 1.5rem Space Grotesk; .sub/.hint Inter; .label-mono 500 .6875rem uppercase) -->
    <style name="TextAppearance.Cobalt.Wordmark" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>
    <style name="TextAppearance.Cobalt.Title" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>
    <style name="TextAppearance.Cobalt.Body" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/cobalt_ink_2</item>
    </style>
    <style name="TextAppearance.Cobalt.Sub" parent="TextAppearance.Cobalt.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cobalt_muted</item>
    </style>
    <style name="TextAppearance.Cobalt.Hint" parent="TextAppearance.Cobalt.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cobalt_muted</item>
    </style>
    <style name="TextAppearance.Cobalt.Label" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cobalt_ink_2</item>
    </style>
    <style name="TextAppearance.Cobalt.LabelMono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/cobalt_muted</item>
    </style>
    <style name="TextAppearance.Cobalt.Code" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/cobalt_ink_2</item>
    </style>
    <style name="TextAppearance.Cobalt.Sas" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/cobalt_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Cobalt.Button" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- The top bar's title and a section card's heading (Settings and the other screens made in code). -->
    <style name="TextAppearance.Cobalt.BarTitle" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>
    <style name="TextAppearance.Cobalt.SectionHead" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Rows (settings rows, file rows, trash rows): title 15sp ink, sub 13sp muted, mono for sizes and counts. -->
    <style name="TextAppearance.Cobalt.RowTitle" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>
    <style name="TextAppearance.Cobalt.RowSub" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textColor">@color/cobalt_muted</item>
    </style>
    <style name="TextAppearance.Cobalt.Meta" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cobalt_muted</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- The brand in the main bar: "discor" ink + "drive" accent (set by the view), like "DiscorDrive Gallery". -->
    <style name="TextAppearance.Cobalt.Brand" parent="">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>
    <!-- The viewer's action labels under the icons (on the dark scrim, both modes). -->
    <style name="TextAppearance.Cobalt.ActionLabel" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cobalt_on_scrim</item>
    </style>
    <!-- An album tile's name and count. -->
    <style name="TextAppearance.Cobalt.TileTitle" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cobalt_ink</item>
    </style>

    <!-- Buttons: rounded-md (6dp), 48dp tall (the web's h-11 + a touch target), no pill, no caps. -->
    <style name="Widget.Cobalt.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="backgroundTint">@color/cobalt_button_primary_bg</item>
        <item name="android:textColor">@color/cobalt_button_primary_text</item>
        <item name="iconTint">@color/cobalt_button_primary_text</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobalt.Button</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- .btn: hairline frame rule-2 on paper, ink-2 text -->
    <style name="Widget.Cobalt.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="strokeColor">@color/cobalt_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/cobalt_paper</item>
        <item name="android:textColor">@color/cobalt_button_secondary_text</item>
        <item name="iconTint">@color/cobalt_button_secondary_text</item>
        <item name="rippleColor">#1A7A8189</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobalt.Button</item>
    </style>

    <!-- Two buttons side by side (Copy / Share, Yes / No): one line always; at a large system font the label
         shrinks to fit (down to 12sp) instead of breaking inside a word. -->
    <style name="Widget.Cobalt.Button.Pair">
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>
    <style name="Widget.Cobalt.Button.Secondary.Pair">
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconPadding">6dp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- .input: 6dp, frame rule-2, 2dp accent when focused, label above (not floating) -->
    <style name="Widget.Cobalt.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxStrokeColor">@color/cobalt_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/cobalt_paper</item>
        <item name="hintEnabled">false</item>
        <item name="placeholderTextColor">@color/cobalt_muted</item>
        <item name="placeholderTextAppearance">@style/TextAppearance.Cobalt.Body</item>
    </style>
    <style name="Widget.Cobalt.TextInput.Edit" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Cobalt.Body</item>
        <item name="android:textColor">@color/cobalt_ink</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Tonal (Choose accent, Restore, Set PIN): the accent at 12% with ink text and an accent icon; it stays
         visible on a dark card (paper-2 on paper did not). Ripple in the accent. -->
    <style name="Widget.Cobalt.Button.Tonal" parent="Widget.Cobalt.Button">
        <item name="backgroundTint">@color/cobalt_button_tonal_bg</item>
        <item name="android:textColor">@color/cobalt_button_tonal_text</item>
        <item name="iconTint">@color/cobalt_button_tonal_icon</item>
        <item name="rippleColor">@color/cobalt_ripple_accent</item>
    </style>
    <!-- Danger (Leave the account, Delete for good, Remove PIN): the error colour at 10%, red text and icon. -->
    <style name="Widget.Cobalt.Button.Danger" parent="Widget.Cobalt.Button">
        <item name="backgroundTint">@color/cobalt_button_danger_bg</item>
        <item name="android:textColor">@color/cobalt_button_danger_text</item>
        <item name="iconTint">@color/cobalt_button_danger_text</item>
        <item name="rippleColor">@color/cobalt_ripple_danger</item>
    </style>

    <style name="Widget.Cobalt.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/cobalt_check_tint</item>
    </style>
    <!-- The loading bar under a list's note: 3dp, rounded, the accent on a faint track. -->
    <style name="Widget.Cobalt.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">3dp</item>
        <item name="trackCornerRadius">2dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">@color/cobalt_paper_3</item>
    </style>

    <!-- A section card (Settings, the other screens made in code): 14dp, filled card colour, no frame. -->
    <style name="Widget.Cobalt.Card.Section" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/cobalt_error_rule</item>
        <item name="cardBackgroundColor">@color/cobalt_card</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- .auth-card / code card: 10dp, hairline rule, flat on paper -->
    <style name="Widget.Cobalt.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cobalt_rule</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/cobalt_paper</item>
        <item name="contentPadding">0dp</item>
    </style>
</resources>
