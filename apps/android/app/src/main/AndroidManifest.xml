<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Android 14+: the user may give access to selected photos only (the automatic copy then sees those). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Keeps the GPS position in the EXIF of copied photos (without it Android strips it). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- usesCleartextTraffic: dev setups talk to test APIs / self-hosted AI
         gateways over plain HTTP (VPN/LAN). Production servers use TLS. -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Gallery">

        <!-- Two launcher icons, one app: "discordrive" (files and folders) and "Galeria" (every photo and
             video of the account). Separate task affinities: two cards in Recents, Back from either root
             closes only that one. -->
        <activity
            android:name=".DdnActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_files"
            android:taskAffinity="io.github.magiszonekk.discordrive.files">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DdnGallery"
            android:exported="true"
            android:label="@string/ddn_gallery"
            android:icon="@mipmap/ic_launcher"
            android:taskAffinity="io.github.magiszonekk.discordrive.gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Share → discordrive (one or more files from any app) -->
        <activity
            android:name=".DdnShareActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gallery"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name=".DdnBackupActivity" android:exported="false" android:label="@string/ddn_backup" />
        <activity android:name=".DdnTrashActivity" android:exported="false" android:label="@string/ddn_trash" />
        <activity android:name=".DdnFreeUpActivity" android:exported="false" android:label="@string/ddn_free" />
        <activity android:name=".DdnEditActivity" android:exported="false" android:theme="@style/Theme.Gallery.Viewer" />
        <activity android:name=".DdnSettingsActivity" android:exported="false" android:label="@string/ddn_settings" />
        <!-- Open with → discordrive: photos and videos of other apps (the system may make it the default gallery). -->
        <activity
            android:name=".DdnOpenActivity"
            android:exported="true"
            android:label="@string/ddn_gallery"
            android:theme="@style/Theme.Gallery.Viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <receiver android:name=".DdnInstallReceiver" android:exported="false" />
        <activity android:name=".DdnViewerActivity" android:exported="false" android:theme="@style/Theme.Gallery.Viewer" />

        <!-- The phone's own photos (old gallery screen): kept for the next steps (auto backup), not in the launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- In-app picker: shows up as an app option when another app asks the
             system for an image/video (GET_CONTENT / PICK). -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:label="@string/picker_title"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".JoinActivity" android:exported="false" android:label="@string/ddn_join_menu" />
        <activity android:name=".AlbumActivity" android:exported="false" />
        <activity android:name=".TrashActivity" android:exported="false" />
        <activity android:name=".SearchActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".WallpaperActivity" android:exported="false" />
        <activity android:name=".EditActivity" android:exported="false" />
        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery.Viewer" />

        <receiver android:name=".SyncActionReceiver" android:exported="false" />

        <!-- Android 14+: declare the FGS type on WorkManager's foreground service
             so setForeground(dataSync) is allowed (else startForeground throws). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- SAF: the gallery as a system file-picker source (Discord attach etc.),
             with the AI cache answering the picker's search box. -->
        <provider
            android:name=".GalleryDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The discordrive account in the system's file picker (read-only). -->
        <provider
            android:name=".DdnDocumentsProvider"
            android:authorities="${applicationId}.ddn.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
