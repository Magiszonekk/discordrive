# discordrive-next instance: documentation of config.json fields.
# The server does NOT read environment variables or this file: `discordrive setup`
# writes <data dir>/config.json (0600). This lists the same settings for reference.

# mode: only "metadata-only" today (e2ee/plain: stage 3)
DDN_MODE=metadata-only
# publicUrl: what users open; the browser needs HTTPS (except 127.0.0.1)
DDN_PUBLIC_URL=https://dysk.example.com
# bind.host / bind.port: address on THIS machine (behind a proxy: the VPN/LAN address, not 0.0.0.0)
DDN_BIND_HOST=127.0.0.1
DDN_BIND_PORT=3020
# dataDir: config.json + ddn.db (default ~/.local/share/discordrive-next)
DDN_DATA_DIR=~/.local/share/discordrive-next
# trustProxy: reverse proxies whose X-Forwarded-For is trusted (client IP for rate limits)
DDN_TRUST_PROXY=
# signup: invite (one-shot codes from `discordrive invite`) | open | closed
DDN_SIGNUP=invite
# botToken: instance bot for share links (POST /attachments/refresh-urls). Secret.
# Empty = sharing off. Give it to `discordrive setup` interactively or with --bot-token-file.
DDN_BOT_TOKEN=
# limits: bodyBytes (any JSON body), opPayloadB64 (one encrypted op), vaultB64 (webhook vault)
DDN_LIMIT_BODY_BYTES=2097152
DDN_LIMIT_OP_PAYLOAD_B64=1048576
DDN_LIMIT_VAULT_B64=524288
