{
  "name": "@ddv4/ddn-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "discordrive-next instance (metadata-only): one process serving the API, the notify websocket and the built web app; `discordrive setup|serve|doctor|invite`.",
  "bin": {
    "discordrive": "./bin/discordrive.mjs"
  },
  "scripts": {
    "setup": "node bin/discordrive.mjs setup",
    "start": "node bin/discordrive.mjs start",
    "doctor": "node bin/discordrive.mjs doctor",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ddv4/metadata-client": "*",
    "@ddv4/sync-core": "*",
    "@ddv4/web-mo": "*",
    "tsx": "^4.19.0",
    "esbuild": "~0.27.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
